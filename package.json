{
  "name": "lightboard",
  "version": "1.0.0",
  "description": "Hebrew-first headless Shopify storefront (Hydrogen + Oxygen) with a live photo-print product customizer.",
  "author": "Ido Lev Ari",
  "license": "UNLICENSED",
  "homepage": "https://lightboard.co.il",
  "repository": {
    "type": "git",
    "url": "https://github.com/idolevari/lightboard.git"
  },
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "shopify hydrogen build --codegen",
    "dev": "shopify hydrogen dev --codegen",
    "preview": "shopify hydrogen preview --build",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "codegen": "shopify hydrogen codegen && react-router typegen",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@shopify/hydrogen": "2026.4.8",
    "graphql": "^16.15.0",
    "graphql-tag": "^2.12.7",
    "isbot": "^5.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.7",
    "react-router": "7.18.5",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@graphql-codegen/cli": "5.0.7",
    "@playwright/test": "1.65.0",
    "@react-router/dev": "7.18.5",
    "@react-router/fs-routes": "7.18.5",
    "@shopify/cli": "3.94.3",
    "@shopify/hydrogen-codegen": "0.3.3",
    "@shopify/mini-oxygen": "4.2.3",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@shopify/prettier-config": "^1.1.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^9.6.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "graphql-config": "^5.0.3",
    "jiti": "^2.6.1",
    "prettier": "^3.9.10",
    "schema-dts": "^1.1.5",
    "typescript": "^5.9.2",
    "vite": "^6.4.2",
    "vite-tsconfig-paths": "^4.3.1",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "overrides": {
    "@shopify/hydrogen": {
      "react-router": "$react-router",
      "@react-router/dev": "$@react-router/dev"
    },
    "@axe-core/playwright": {
      "playwright-core": "1.64.1"
    }
  }
}
